# $BEEF bot environment — every variable validated at boot by src/common/config/env.validation.ts (Zod).
# Copy to .env and fill in what you need; everything optional unless marked required.
# Cross-field rules (enforced by superRefine):
#   - NODE_ENV=production            → TELEGRAM_BOT_TOKEN required
#   - TWITTER_CLIENT_MODE=hybrid     → PROXY_URL + CHROME_PROFILE_PATH required
#   - BEEF_ENV=production + api/hybrid mode → full TWITTER_API_* credential set required

# --- Bot environment ---------------------------------------------------------
BEEF_ENV=test                    # test | production (selects account identity)
NODE_ENV=development             # development | production | test
LOG_LEVEL=debug                  # fatal | error | warn | info | debug | trace

# --- Twitter: client mode ----------------------------------------------------
TWITTER_CLIENT_MODE=api          # api (API v2) | scraper (cookie auth) | hybrid (API reads + Playwright writes)
TWITTER_BOT_USERNAME=            # bot handle without @ (mention filtering in API mode)

# --- Twitter: Official API v2 ------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Twitter: scraper credentials (cookie auth) ------------------------------
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_PHONE=
TWITTER_2FA_SECRET=              # TOTP secret from authenticator app

# --- Twitter: browser session cookies (Playwright, avoids login flow) --------
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_TWID=
TWITTER_KDT=

# --- Playwright browser automation (hybrid mode) -----------------------------
PROXY_URL=                       # http(s):// or socks4/5:// — residential proxy for anti-detection
CHROME_PROFILE_PATH=             # persistent Chrome profile directory
CHROME_EXECUTABLE_PATH=          # optional custom Chrome binary
BROWSER_TIMEZONE=Asia/Singapore

# --- LLM providers -----------------------------------------------------------
CODEX_ENABLED=true               # Codex CLI as secondary fallback provider
ANTHROPIC_API_KEY=               # Anthropic SDK as tertiary fallback (pay-per-token)
OPENAI_API_KEY=                  # Whisper transcription for /feedback voice notes

# --- Retrieval service (../retrieval-service) ----------------------------------
RETRIEVAL_SERVICE_URL=           # e.g. http://localhost:8100 — optional; lexical FTS5 fallback when unset

# --- Storage -----------------------------------------------------------------
DB_PATH=./data/beef.db

# --- Base chain --------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
BEEF_TOKEN_ADDRESS=

# --- Bot behavior ------------------------------------------------------------
BOT_NAME=0xBeef
ROASTS_PER_DAY=10                # 1-20, autonomous roast cap per day
MENTION_REPLIES_PER_DAY=20       # 1-100
MIN_FOLLOWER_THRESHOLD=250       # ignore mention requests from smaller accounts
MENTION_POLL_INTERVAL_MS=300000  # >= 60000
DRY_RUN=false                    # true = full pipeline, nothing posted
ENABLE_TWITTER=true              # false = disable all Twitter I/O
ENABLE_AUTONOMOUS_POSTING=false  # true = post standalone roasts to feed
ENABLE_MENTION_REPLIES=true      # true = reply to mention requests

# --- Telegram admin ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=              # required when NODE_ENV=production
TELEGRAM_CHAT_ID=                # main admin group for alerts
TELEGRAM_MONITOR_CHAT_ID=        # separate group for timeline-monitor digests
TELEGRAM_ADMIN_IDS=              # comma-separated Telegram user IDs (e.g. 123456,789012)
TELEGRAM_OPEN_ACCESS=false       # true = any user may issue commands (dev only)

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=

# --- Meme generation ---------------------------------------------------------
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# --- Activity feed (web app "bot diary") --------------------------------------
ACTIVITY_FEED_ENABLED=true
ACTIVITY_FEED_PATH=./data/activity-feed.json

# --- API server (dashboard / OpenClaw bridge) ---------------------------------
API_PORT=3001                    # 1024-65535
API_AUTH_TOKEN=                  # bearer token protecting the local API

# --- Autonomy: farm (offline batch generation) --------------------------------
ENABLE_AUTO_FARM=false
AUTO_FARM_INTERVAL_HOURS=6       # 1-24
AUTO_FARM_TARGET_COUNT=5         # 1-10

# --- Autonomy: auto-posting from stockpile -------------------------------------
ENABLE_AUTO_POST=false
AUTO_POST_INTERVAL_HOURS=3       # 1-12
MAX_AUTO_POSTS_PER_DAY=3         # 1-10
AUTO_POST_MIN_SCORE=4.0          # 1-5, minimum judge composite to auto-post
AUTO_POST_MIN_BUFFER=5           # 1-20, keep at least N stockpiled roasts in reserve

# --- Autonomy: reply-guy pipeline ----------------------------------------------
ENABLE_REPLY_GUY=false
REPLY_GUY_DRY_RUN=true
REPLY_GUY_DAILY_CAP=40           # 5-100, tweets scored per day
REPLY_GUY_MIN_ROASTABILITY=5     # 1-10
REPLY_GUY_MAX_AGE_MINUTES=60     # 10-180, skip stale tweets
REPLY_GUY_MIN_SCORE=12           # 5-25, composite targeting threshold
REPLY_GUY_MAX_PER_CYCLE=3        # 1-10
REPLY_GUY_MAX_DAILY_POSTS=7      # 0-30
REPLY_GUY_MAX_PER_AUTHOR_DAILY=2 # 1-10, anti-spam per author
DISABLE_QUIET_HOURS=false        # true = post at any hour (testing only)

# --- Learning loop -------------------------------------------------------------
ENABLE_LEARNING_LOOP=false       # engagement tracking + human-feedback prompt calibration
