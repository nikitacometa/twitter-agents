# Twitter API (Basic tier, $200/mo)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# X Premium account credentials (for cookie auth fallback)
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# Anthropic
ANTHROPIC_API_KEY=

# Base chain
BASE_RPC_URL=https://mainnet.base.org
BEEF_TOKEN_ADDRESS=

# Bot config
BOT_NAME=0xBeef
ROASTS_PER_DAY=5
MENTION_POLL_INTERVAL_MS=600000
POST_JITTER_PERCENT=30
DRY_RUN=false                    # true = log tweets without posting
ENABLE_AUTONOMOUS_POSTING=false  # true = post standalone roasts to feed
ENABLE_MENTION_REPLIES=true      # true = reply to mention requests

# Monitoring
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=          # comma-separated Telegram user IDs (e.g., 123456,789012)

# Imgflip (meme generation)
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# Environment
NODE_ENV=development
LOG_LEVEL=debug
